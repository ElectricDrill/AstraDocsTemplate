{
  "metadata": [
    {
      "src": [],
      "globalNamespaceId": "Global",
      "filter": "filterConfig.yml",
      "dest": "api",
      "allowCompilationErrors": false,
      "properties": {
        "ProduceReferenceAssembly": "true"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**", ".astra-workspace/**"] },
      { "files": ["api/toc.yml"] }
    ],
    "resource": [
      { "files": ["DocFx/images/**"] }
    ],
    "output": "_site",
    "template": ["default", "modern", "DocFx/templates/astra"],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "{{TITLE}}",
      "_appTitle": "{{TITLE}}",
      "_appLogoPath": "DocFx/images/astra-logo.svg",
      "_enableSearch": true,
      "_enableBreadcrumb": true,
      "_disableContribution": true,
      "_baseUrl": "{{PAGES_URL}}"
    },
    "xref": []
  }
}
